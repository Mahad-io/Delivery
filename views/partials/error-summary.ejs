<% if (typeof errors !== 'undefined' && errors && errors.length) { %>
<div class="error-summary" role="alert" tabindex="-1" id="error-summary" data-error-summary>
  <h2>There is a problem</h2>
  <ul>
    <% errors.forEach(function (e) { %>
      <li>
        <% if (e.field) { %>
          <a href="#<%= e.field %>"><%= e.message %></a>
        <% } else { %>
          <%= e.message %>
        <% } %>
      </li>
    <% }) %>
  </ul>
</div>
<% } %>
