<%- include('../partials/top') %>

<div class="wrap">
  <div class="page-head">
    <h1>Hello <%= user.name.split(' ')[0] %></h1>
    <p class="lede">
      <%= modulesDone %> of <%= totalModules %> learning modules complete,
      <%= downloads.length %> template<%= downloads.length === 1 ? '' : 's' %> downloaded,
      <%= saved.length %> saved.
    </p>
    <% if (!user.email_verified) { %>
      <div class="notice notice--warn">
        <h2>Confirm your email address</h2>
        <p>We sent a link to <%= user.email %>. Some features stay locked until you use it.</p>
        <form method="post" action="/verify/resend">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--small" type="submit">Send it again</button>
        </form>
      </div>
    <% } %>
  </div>

  <div class="grid grid--sidebar">
    <div>
      <section class="mb-6">
        <h2 class="mt-0">Learning progress</h2>
        <div class="stack">
          <% paths.forEach(function (p) { %>
            <div class="card">
              <h3 style="margin-top:0;font-size:1.0625rem"><a href="/learning/<%= p.id %>"><%= p.title %></a></h3>
              <div class="progress">
                <div class="progress__track">
                  <div class="progress__fill <%= p.progress.percent === 100 ? 'progress__fill--full' : '' %>" style="width: <%= p.progress.percent %>%"></div>
                </div>
                <span class="progress__label"><%= p.progress.done %>/<%= p.progress.of %></span>
              </div>
            </div>
          <% }) %>
        </div>
      </section>

      <% if (assessments.length) { %>
        <section class="mb-6">
          <h2>Assessment history</h2>
          <div class="table-scroll" tabindex="0" role="region" aria-label="Assessment history">
            <table>
              <thead><tr><th scope="col">Date</th><th scope="col">Overall</th><th scope="col">Band</th><th scope="col">Weakest dimension</th></tr></thead>
              <tbody>
                <% assessments.forEach(function (a) { %>
                  <tr>
                    <td><%= a.created_at %></td>
                    <td><%= a.scores.percent %>%</td>
                    <td><%= a.scores.overallBand %></td>
                    <td><%= a.scores.weakest.name %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <p><a href="/tools/assessment">Take it again</a></p>
        </section>
      <% } %>

      <% if (saved.length) { %>
        <section class="mb-6">
          <h2>Saved templates</h2>
          <div class="grid grid--2">
            <% saved.forEach(function (resource) { %>
              <%- include('../partials/resource-card', { resource: resource }) %>
            <% }) %>
          </div>
        </section>
      <% } %>

      <% if (boards.length) { %>
        <section class="mb-6">
          <h2>Retro boards</h2>
          <ul class="list-plain list-spaced">
            <% boards.forEach(function (b) { %>
              <li><a href="/tools/retro/<%= b.id %>"><%= b.title %></a> <span class="caption">&mdash; last changed <%= b.updated_at %></span></li>
            <% }) %>
          </ul>
        </section>
      <% } %>

      <% if (downloads.length) { %>
        <section class="mb-6">
          <h2>Download history</h2>
          <div class="table-scroll" tabindex="0" role="region" aria-label="Download history">
            <table>
              <thead><tr><th scope="col">Template</th><th scope="col">Format</th><th scope="col">Times</th><th scope="col">Last</th></tr></thead>
              <tbody>
                <% downloads.forEach(function (d) { %>
                  <tr>
                    <td><% if (d.resource) { %><a href="/resources/<%= d.resource.id %>"><%= d.resource.title %></a><% } else { %><%= d.resource_id %><% } %></td>
                    <td><%= d.format.toUpperCase() %></td>
                    <td><%= d.times %></td>
                    <td><%= d.created_at %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
      <% } %>

      <section>
        <h2>Your details</h2>
        <form method="post" action="/account/profile">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-group">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" value="<%= user.name %>" autocomplete="name">
          </div>
          <div class="form-group">
            <label for="job_role">Role <span class="hint">Optional</span></label>
            <input type="text" id="job_role" name="job_role" value="<%= user.job_role || '' %>">
          </div>
          <div class="form-group">
            <label for="organisation">Organisation <span class="hint">Optional</span></label>
            <input type="text" id="organisation" name="organisation" value="<%= user.organisation || '' %>">
          </div>
          <div class="form-group">
            <label for="experience_level">Years in delivery <span class="hint">Optional</span></label>
            <select id="experience_level" name="experience_level">
              <option value="">Prefer not to say</option>
              <option value="new" <%= user.experience_level === 'new' ? 'selected' : '' %>>New to it</option>
              <option value="1-3" <%= user.experience_level === '1-3' ? 'selected' : '' %>>1 to 3 years</option>
              <option value="3-7" <%= user.experience_level === '3-7' ? 'selected' : '' %>>3 to 7 years</option>
              <option value="7+" <%= user.experience_level === '7+' ? 'selected' : '' %>>More than 7 years</option>
            </select>
          </div>
          <p class="caption">
            To change your email address, email
            <a href="mailto:<%= config.org.supportEmail %>"><%= config.org.supportEmail %></a> &mdash;
            we do it by hand to stop account takeover.
          </p>
          <button class="btn" type="submit">Save changes</button>
        </form>
      </section>
    </div>

    <aside aria-labelledby="account-side">
      <div class="panel panel--brand">
        <h2 id="account-side" class="mt-0" style="font-size:1.0625rem">Your data</h2>
        <ul class="list-plain list-spaced">
          <li><a href="/account/privacy">What we hold, and your consent history</a></li>
          <li><a href="/account/data.json">Download everything (JSON)</a></li>
          <li><a href="/account/data.txt">Download everything (plain text)</a></li>
          <li><a href="/cookies">Cookie settings</a></li>
          <li><a href="/account/requests">Other data requests</a></li>
          <li><a href="/account/delete">Delete your account</a></li>
        </ul>
      </div>
      <div class="panel mt-4">
        <h2 class="mt-0" style="font-size:1.0625rem">Account</h2>
        <dl class="dl-grid">
          <dt>Email</dt><dd><%= user.email %></dd>
          <dt>Confirmed</dt><dd><%= user.email_verified ? 'Yes' : 'Not yet' %></dd>
          <dt>Created</dt><dd><%= user.created_at %></dd>
          <dt>Last sign-in</dt><dd><%= user.last_login_at || 'This is your first' %></dd>
        </dl>
      </div>
    </aside>
  </div>
</div>

<%- include('../partials/bottom') %>
