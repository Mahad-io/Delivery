<%- include('../partials/top') %>

<div class="wrap">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li><li><a href="/tools">Tools</a></li>
      <li><a href="/tools/retro">Retro board</a></li><li><%= board.title %></li>
    </ol>
  </nav>

  <div class="page-head">
    <span class="eyebrow"><%= template.name %></span>
    <h1><%= board.title %></h1>
    <div class="btn-row">
      <a class="btn btn--small btn--secondary" href="/tools/retro/<%= board.id %>/export.md">Export as markdown</a>
      <a class="btn btn--small btn--plain" href="/tools/retro">All your boards</a>
    </div>
  </div>

  <div class="board">
    <% template.columns.forEach(function (col) { %>
      <section class="board__col" aria-labelledby="col-<%= col.id %>">
        <h2 id="col-<%= col.id %>"><%= col.name %></h2>
        <p class="hint"><%= col.prompt %></p>

        <% items.filter(function (i) { return i.column_id === col.id; }).forEach(function (item) { %>
          <article class="note">
            <p style="margin:0"><%= item.body %></p>
            <div class="note__actions">
              <form method="post" action="/tools/retro/<%= board.id %>/items/<%= item.id %>/vote">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="direction" value="up">
                <button class="btn btn--small btn--secondary" type="submit" aria-label="Add a vote to: <%= item.body.slice(0, 40) %>">+1</button>
              </form>
              <span class="note__votes" aria-label="<%= item.votes %> votes"><%= item.votes %></span>
              <form method="post" action="/tools/retro/<%= board.id %>/items/<%= item.id %>/vote">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="direction" value="down">
                <button class="btn btn--small btn--secondary" type="submit" aria-label="Remove a vote from: <%= item.body.slice(0, 40) %>">&minus;1</button>
              </form>
              <form method="post" action="/tools/retro/<%= board.id %>/items/<%= item.id %>/delete">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn--small btn--plain" type="submit" aria-label="Delete note: <%= item.body.slice(0, 40) %>">Delete</button>
              </form>
            </div>
          </article>
        <% }) %>

        <form method="post" action="/tools/retro/<%= board.id %>/items">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="column_id" value="<%= col.id %>">
          <div class="form-group" style="margin-bottom:8px">
            <label for="add-<%= col.id %>" class="visually-hidden">Add a note to <%= col.name %></label>
            <textarea id="add-<%= col.id %>" name="body" rows="2" maxlength="500" style="max-width:none"></textarea>
          </div>
          <button class="btn btn--small" type="submit">Add note</button>
        </form>
      </section>
    <% }) %>
  </div>

  <section class="section">
    <div class="grid grid--2">
      <div class="panel panel--brand">
        <h2 class="mt-0">Before you finish</h2>
        <ul class="mb-0">
          <li>Two actions maximum. Five actions is zero actions.</li>
          <li>Each one needs a named person and a date, in the backlog, not in these notes.</li>
          <li>If a theme has come up three times, it is not a retro action &mdash; it is an escalation.</li>
          <li>Open the next retro by reviewing these. That single habit changes everything.</li>
        </ul>
      </div>
      <div class="panel">
        <h2 class="mt-0">Delete this board</h2>
        <p>Deletes the board and every note on it, permanently and immediately.</p>
        <form method="post" action="/tools/retro/<%= board.id %>/delete">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--small btn--secondary" type="submit">Delete board</button>
        </form>
      </div>
    </div>
  </section>
</div>

<%- include('../partials/bottom', { scripts: ['retro'] }) %>
