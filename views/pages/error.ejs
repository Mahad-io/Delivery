<%- include('../partials/top') %>

<div class="wrap wrap--narrow">
  <div class="page-head">
    <span class="eyebrow">Error <%= status %></span>
    <h1><%= heading %></h1>
    <p class="lede"><%= message %></p>
  </div>
  <div class="btn-row">
    <a class="btn" href="/">Go to the home page</a>
    <a class="btn btn--secondary" href="/toolkit">Browse the toolkit</a>
  </div>
  <p class="mt-6">
    If you think something is broken, email
    <a href="mailto:<%= config.org.supportEmail %>"><%= config.org.supportEmail %></a>
    and tell us what you were trying to do. We would rather know.
  </p>
</div>

<%- include('../partials/bottom') %>
